# MediaFlow AI local demo configuration.
# Copy to .env before running Docker Compose.

MYSQL_ROOT_PASSWORD=mediaflow-root
DB_NAME=mediaflow
DB_USER=mediaflow
DB_PASSWORD=mediaflow-demo

# mock: deterministic local demo; openai: any OpenAI-compatible chat endpoint.
AI_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

GRAFANA_USER=admin
GRAFANA_PASSWORD=mediaflow
QUEUE_ENABLED=true
SERVER_PORT=8090
